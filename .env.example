# Copy to .env (or run `uv run f1engineer setup`, which writes it for you). Never commit .env.

# --- OpenAI (optional: conversational engineer; without it an offline template brain answers) ---
# Get a key: https://platform.openai.com/api-keys  ->  "Create new secret key". Add credit under Billing.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
# lowest reasoning effort tried first (none -> minimal -> low); raise to "low" for smarter, slower answers
OPENAI_REASONING=none

# --- Engineer ---
F1E_SASS=2                      # 0 professional .. 3 roasts you
F1E_TTS_VOICE=en_GB-alan-medium # any Piper voice id
F1E_PTT_KEY=shift               # hold to talk (keyboard; either Shift)
F1E_MIC=                        # part of your mic's name, e.g. Kraken (empty = Windows default input)
F1E_PTT_BUTTON=RS               # hold to talk (controller): A B X Y LB RB LS RS VIEW DPAD_UP ...
F1E_STT_MODEL=auto              # auto | tiny.en | base.en | small.en
F1E_GPU=auto                    # auto = use GPU only when free; off = CPU only

# --- Network ---
F1E_UDP_HOST=127.0.0.1          # 0.0.0.0 to receive from a console on your LAN
F1E_UDP_PORT=20777
F1E_WEB_PORT=8020

# --- Guardrails ---
F1E_MIN_FREE_GB=5.5             # stop writing data below this much free disk
F1E_MAX_DATA_GB=1.0             # cap for data/ (old sessions pruned)
F1E_MAX_RSS_MB=1500             # engine restarts itself above this memory
F1E_KEEP_SESSIONS=5             # sessions of full telemetry kept
F1E_VOLUME=1.0                  # radio loudness 0..1
F1E_HISTORY_DAYS=90             # lap summaries for progress tracking (~2 KB per lap)
F1E_RADIO_DAYS=30               # radio / chat log
F1E_KEEP_CAPTURES=2             # raw .f1cap recordings (100-200 MB each)
F1E_CAPTURE_DAYS=30
